# Copy this file to apps/web/.env.local and apps/dashboard/.env.local
# (both apps talk to the same Supabase project).

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Used by API routes and the seed script.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Marketing site origin — dashboard /login uses this to link to /signup.
# Local: http://localhost:3000  Production: https://www.glamsitestudio.com
NEXT_PUBLIC_WEB_URL=http://glamsitestudio.com

# Seller dashboard origin — marketing Login / Get your website go here.
# Local: http://localhost:3001  Production: https://dashboard.glamsitestudio.com
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# Hubtel (payments) — fill in once you've confirmed rates
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=

# Glam Site Studios MoMo for seller subscription payments (dashboard /dashboard/billing).
ANSAA_MOMO_NUMBER=
ANSAA_MOMO_ACCOUNT_NAME=Glam Site Studios

# Dashboard only. Comma-separated emails that can open /dashboard/admin.
ADMIN_EMAILS=

# Support tickets (dashboard only, Resend). FROM must be a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Glam Site Studios Support <support@yourdomain.com>
SUPPORT_INBOX_EMAIL=you@yourdomain.com
