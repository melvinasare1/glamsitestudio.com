# Copy this file to apps/web/.env.local and apps/dashboard/.env.local.
# Local development always uses the STAGING Supabase project, never production.
# See docs/infrastructure.md for which variable each app needs.

# Supabase staging (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Used by API routes and the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# Marketing site and customer sites (apps/web).
# Local: http://localhost:3000  Production: https://glamsitestudio.com
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Owner dashboard (apps/dashboard).
# Local: http://localhost:3001  Production: https://dashboard.glamsitestudio.com
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# Dashboard only. Comma-separated emails that can open /dashboard/admin.
ADMIN_EMAILS=
# Dashboard only, optional. Affiliate link shown when an owner needs to buy a domain.
NEXT_PUBLIC_NAMECHEAP_AFFILIATE_URL=

# Email (dashboard only, Resend). FROM must be on a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Glam Site Studios <hello@glamsitestudio.com>
SUPPORT_INBOX_EMAIL=

# Stripe (stage 3). Use TEST keys locally and on previews.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
