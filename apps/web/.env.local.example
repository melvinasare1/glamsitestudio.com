# Supabase (Project Settings → API) — same project as the dashboard app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Used by /api/leads, /api/checkout, /api/track, and the seed script.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# This app's public origin. Dashboard uses the same var to link here (e.g. /signup).
# Local: http://localhost:3000  Production: https://www.glamsitestudio.com
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Seller dashboard origin for Login / Get your website on the landing page.
# Local: http://localhost:3001  Production: https://dashboard.glamsitestudio.com
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# Optional local preview only. Live seller pages resolve from the URL
# `/store/{template}/{store_slug}` and ignore this variable.
# When set, demo routes (`/store/{template}` with no slug) load that seller.
# NEXT_PUBLIC_STORE_SLUG=

# Hubtel (payments) — fill in once you've confirmed rates
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
