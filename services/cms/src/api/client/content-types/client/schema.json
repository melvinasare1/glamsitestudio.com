{
  "kind": "collectionType",
  "collectionName": "clients",
  "info": {
    "singularName": "client",
    "pluralName": "clients",
    "displayName": "Client",
    "description": "Core tenant (one Strapi instance, many clients)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "domain": {
      "type": "string"
    },
    "plan": {
      "type": "enumeration",
      "enum": ["starter", "growth", "pro"],
      "default": "starter"
    },
    "stripeCustomerId": {
      "type": "string"
    },
    "subscriptionStatus": {
      "type": "enumeration",
      "enum": ["active", "past_due", "canceled"],
      "default": "active"
    },
    "pages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::page.page",
      "mappedBy": "client"
    },
    "subscription": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::subscription.subscription",
      "mappedBy": "client"
    },
    "users": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "client"
    }
  }
}
